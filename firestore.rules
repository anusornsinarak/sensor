rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidSensorData(data) {
      return data.keys().hasAll(['timestamp', 'temperature', 'humidity']) &&
             data.keys().size() == 3 &&
             data.timestamp is number &&
             data.temperature is number &&
             data.humidity is number;
    }

    match /sensor_data/{dataId} {
      // Allow anyone to read the dashboard data.
      allow get: if true;
      allow list: if resource.data.timestamp > 0;

      // Allow creating new sensor data if it matches the schema.
      // In a real production app, you would require a secret token here.
      allow create: if isValidSensorData(incoming());
    }
  }
}
